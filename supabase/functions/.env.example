# Secrets des Edge Functions en local : copiez ce fichier en `supabase/functions/.env`
# (ignoré par git) puis lancez `npx supabase functions serve --env-file supabase/functions/.env`.
# En production : npx supabase secrets set RESEND_API_KEY=... RESEND_FROM=... RESEND_TEST_RECIPIENT=...
RESEND_API_KEY=re_votre_cle_api_resend
# Expéditeur (domaine vérifié dans Resend). `onboarding@resend.dev` ne peut écrire
# qu'à l'adresse du compte Resend.
RESEND_FROM=RestauResa <onboarding@resend.dev>
# Destinataire par défaut de l'email de test (sinon : l'email de l'administrateur connecté).
RESEND_TEST_RECIPIENT=vous@exemple.fr
