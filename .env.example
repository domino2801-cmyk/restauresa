# Copiez ce fichier en `.env.local` et renseignez les valeurs de votre projet Supabase
# (Project Settings > API).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Emails (Resend) : la clé API Resend est un SECRET côté serveur. Ne la préfixez
# jamais par VITE_ et ne la mettez pas ici : voir `supabase/functions/.env.example`.
